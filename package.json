{
  "name": "tyle-desktop",
  "version": "1.1.0",
  "description": "ty\\e — AI engineering assistant (desktop)",
  "main": "main.js",
  "author": {
    "name": "GooveXCo",
    "email": "hello@tylellm.com",
    "url": "https://tylellm.com"
  },
  "license": "UNLICENSED",
  "private": true,
  "homepage": "https://tylellm.com",
  "scripts": {
    "start": "electron .",
    "dev": "TYLE_DEV_URL=http://localhost:8000/app electron .",
    "icons": "python -I tools/mk_icons.py build",
    "pack": "electron-builder --dir",
    "dist": "electron-builder -mwl --publish never",
    "dist:mac": "electron-builder --mac --publish never",
    "dist:win": "electron-builder --win --publish never",
    "dist:linux": "electron-builder --linux --publish never",
    "release:win": "node tools/release.mjs",
    "stats": "node tools/download-stats.mjs"
  },
  "dependencies": {
    "electron-updater": "6.8.11"
  },
  "devDependencies": {
    "electron": "45.2.3",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "com.goovex.tyle",
    "productName": "ty\\e",
    "copyright": "Copyright © 2026 GooveXCo Ltd.",
    "directories": {
      "buildResources": "build",
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "updater.js",
      "build/icon.png",
      "build/tray.ico",
      "build/tray.png",
      "build/tray@2x.png"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "build/icon.icns",
      "target": [
        { "target": "dmg",  "arch": ["arm64", "x64"] },
        { "target": "zip",  "arch": ["arm64", "x64"] }
      ],
      "hardenedRuntime": true,
      "gatekeeperAssess": false
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        { "target": "nsis",     "arch": ["x64"] },
        { "target": "portable", "arch": ["x64"] }
      ]
    },
    "nsis": {
      "artifactName": "tye-Setup-${version}.${ext}",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "ty∖e",
      "installerLanguages": ["en_US"],
      "multiLanguageInstaller": false,
      "installerSidebar": "build/installerSidebar.bmp",
      "uninstallerSidebar": "build/uninstallerSidebar.bmp"
    },
    "portable": {
      "artifactName": "tye-portable-x64.exe"
    },
    "linux": {
      "icon": "build/icon.png",
      "category": "Utility;Office",
      "target": ["AppImage", "deb", "rpm"]
    },
    "publish": {
      "provider": "github",
      "owner": "goovexco-glitch",
      "repo": "ty-e",
      "releaseType": "draft"
    }
  }
}
